<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.o3p.widgets</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="o3p theme"
                     string="o3p theme"
                     name="o3p_widgets"
                     groups="base.group_system">
                    <block title="odoo widgets settings">
                        <separator string="Elements Height"/>
                        <setting id="o3p_widgets_minimum_text_lines"
                                 string="Minimum lines for text fields."
                                 help="Minimum number of lines displayed by text fields. The native Odoo value is 2; changes take effect after refreshing the browser.">
                            <field name="minimum_text_lines"
                                   options="{'type': 'number', 'min': 1}"/>
                        </setting>
                        <setting id="o3p_widgets_minimum_lists_lines"
                                 string="Minimum lines for list views."
                                 help="Minimum number of rows displayed by list views. The Add a line row counts toward the total. The native Odoo value is 4; changes take effect after refreshing the browser.">
                            <field name="minimum_lists_lines"
                                   options="{'type': 'number', 'min': 0}"/>
                        </setting>
                        <separator string="Form Groups"/>
                        <setting id="o3p_widgets_enable_group_accordion"
                                 string="Enable support of accordion=&quot;true&quot; for groups"
                                 help="Allow form groups with accordion=&quot;true&quot; to collapse and expand. Changes take effect after refreshing the browser.">
                            <field name="enable_group_accordion"/>
                        </setting>
                        <setting id="o3p_widgets_sticky_group_accordion"
                                 string="Sticky accordion open-close status"
                                 help="Remember each accordion group's last open or closed state in this browser for one month. Changes take effect after refreshing the browser."
                                 invisible="not enable_group_accordion">
                            <field name="sticky_group_accordion"/>
                        </setting>
                        <separator string="Notebook Tabs"/>
                        <setting id="o3p_widgets_remember_notebook_tabs"
                                 string="Remember notebook tabs"
                                 help="Remember and restore the last open tab in each notebook for 48 hours in this browser. Changes take effect after refreshing the browser.">
                            <field name="remember_notebook_tabs"/>
                        </setting>
                        <setting id="o3p_widgets_default_notebook_tabs"
                                 string="Default notebook tabs"
                                 help="Use key-prefix rules to choose a notebook tab when this browser has no exact saved tab. Both notebook and tab indexes start at 0. Changes take effect after refreshing the browser.">
                            <field name="notebook_default_tabs"/>
                            <div class="content-group mt16" invisible="not notebook_default_tabs">
                                <div class="text-muted mb-2">
                                    Each memory key starts with <code>::[N]</code>, where
                                    <code>N</code> is the notebook's zero-based position in the
                                    page's <code>.o_notebook</code> selector result:
                                    <code>::[0]</code> is the first notebook,
                                    <code>::[1]</code> is the second, and so on. The configured
                                    tab index is also zero-based: <code>0</code> selects its first
                                    tab and <code>1</code> its second.<br/>
                                    Current examples: <code>::[0]contacts/</code> selects tab
                                    <code>0</code> for the first notebook on Contacts URLs;
                                    <code>::[0]action216/</code> selects tab <code>0</code> for
                                    the first notebook on action216 URLs.
                                </div>
                                <field name="notebook_default_tab_memory_ids"
                                       nolabel="1"
                                       domain="[('mtype', '=', 'lastnbtab')]"
                                       context="{'default_mtype': 'lastnbtab'}">
                                    <list string="defaults">
                                        <field name="mtype" column_invisible="True"/>
                                        <field name="tvalue"
                                               string="prefix"
                                               placeholder="contacts/"
                                               required="1"/>
                                        <field name="nvalue"
                                               string="tab"
                                               required="1"
                                               options="{'type':'number','min': 0}"/>
                                    </list>
                                    <form string="Default notebook tab">
                                        <group>
                                            <field name="mtype" invisible="1"/>
                                            <field name="tvalue"
                                                   string="URL Prefix"
                                                   placeholder="contacts/"
                                                   required="1"/>
                                            <field name="nvalue"
                                                   string="Tab Index (from 0)"
                                                   required="1"
                                                   options="{'type': 'number', 'min': 0}"/>
                                        </group>
                                    </form>
                                </field>
                            </div>
                        </setting>
                    </block>
                    <block title="Odoo UI Settings">
                        <setting id="o3p_widgets_enable_scroll_load"
                                 string="Enable scroll loading"
                                 help="Load more records when scrolling to the bottom of ungrouped list and kanban views, and show a Load all button. Disabled by default. Changes take effect after refreshing the browser.">
                            <field name="enable_scroll_load"/>
                        </setting>
                        <setting id="o3p_widgets_enable_resizable_chatter"
                                 string="Enable resizable chatter"
                                 help="Allow side chatters to be resized by dragging their left edge. The selected width is remembered in this browser; double-click the resize edge to restore Odoo's default width. Changes take effect after refreshing the browser.">
                            <field name="enable_resizable_chatter"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
